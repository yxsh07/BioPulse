<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="16dp" android:minHeight="80dp" android:background="@drawable/panel_border" android:orientation="vertical" android:focusable="true" android:clickable="true">
    <TextView android:id="@+id/row_badge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.BioPulse.Eyebrow" />
    <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="18sp" android:textColor="@color/primary_text" />
    <TextView android:id="@+id/row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/Text.BioPulse.Metadata" />
</LinearLayout>