<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/vital_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.BioPulse.Eyebrow" />
    <TextView android:id="@+id/vital_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/primary_text" android:textSize="48sp" />
    <TextView android:id="@+id/vital_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.BioPulse.Metadata" />
    <TextView android:id="@+id/vital_metadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/Text.BioPulse.Metadata" />
</LinearLayout>