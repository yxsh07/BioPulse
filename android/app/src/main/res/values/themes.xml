<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Theme.BioPulse" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="colorPrimary">@color/primary_text</item>
        <item name="colorPrimaryVariant">@color/canvas</item>
        <item name="colorOnPrimary">@color/canvas</item>
        <item name="colorSecondary">@color/ecg</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/metadata</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="materialButtonStyle">@style/Widget.BioPulse.Button</item>
        <item name="textInputStyle">@style/Widget.BioPulse.Input</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.BioPulse.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/boundary</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.BioPulse.Primary" parent="Widget.BioPulse.Button">
        <item name="backgroundTint">@color/primary_text</item>
        <item name="android:textColor">@color/canvas</item>
    </style>
    <style name="Widget.BioPulse.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/boundary</item>
        <item name="hintTextColor">@color/metadata</item>
    </style>
    <style name="Text.BioPulse.Section" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="Text.BioPulse.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="Text.BioPulse.Eyebrow" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/metadata</item>
    </style>
    <style name="Text.BioPulse.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Text.BioPulse.Metadata" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/metadata</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>